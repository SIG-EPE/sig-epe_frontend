# =============================================
# SIG-EPE Frontend — Environment Variables
# Copy to .env.local and fill in actual values
# =============================================

# Public (exposed to browser)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=SIG-EPE
# POA code model and replacement aliases remain disabled until verified rollout.
NEXT_PUBLIC_POA_CATALOG_CODE_MODEL_ENABLED=false
NEXT_PUBLIC_POA_CATALOG_ALIAS_WORKFLOW_ENABLED=false
# Additive POA territory rollout. Defaults preserve the current anchor-only UI.
NEXT_PUBLIC_POA_TERRITORY_SELECTION_WRITE_ENABLED=false
NEXT_PUBLIC_POA_TERRITORY_SELECTION_READ_ENABLED=false
NEXT_PUBLIC_POA_TERRITORY_SELECTION_IMPORT_ENABLED=false
NEXT_PUBLIC_POA_TERRITORY_SELECTION_REPORTS_ENABLED=false
# Nullable source-month semantics remain opt-in per deployment. Operational
# planning stays numeric when this flag is false.
NEXT_PUBLIC_POA_SOURCE_MONTHS_ENABLED=false
# Advisory only: any valid email is accepted; corporate email is recommended.
NEXT_PUBLIC_ONBOARDING_RECOMMENDED_EMAIL_DOMAINS=ensenaperu.org
# Legacy fallback name for older deployments only:
# NEXT_PUBLIC_ONBOARDING_ALLOWED_EMAIL_DOMAINS=ensenaperu.org

# Server-only (used by middleware for JWT verification)
JWT_ACCESS_SECRET=same-value-as-backend-jwt-access-secret
