# =============================================
# SIG-EPE Frontend — Environment Variables
# Copy to .env.local and fill in actual values
# =============================================

# Public (exposed to browser)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=SIG-EPE
# Advisory only: any valid email is accepted; corporate email is recommended.
NEXT_PUBLIC_ONBOARDING_RECOMMENDED_EMAIL_DOMAINS=ensenaperu.org
# Legacy fallback name for older deployments only:
# NEXT_PUBLIC_ONBOARDING_ALLOWED_EMAIL_DOMAINS=ensenaperu.org

# Server-only (used by middleware for JWT verification)
JWT_ACCESS_SECRET=same-value-as-backend-jwt-access-secret
